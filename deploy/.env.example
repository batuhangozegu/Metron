# Copy to deploy/.env and change the password. deploy/.env is git-ignored.
POSTGRES_DB=metron
POSTGRES_USER=metron
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433
REDIS_PORT=6379
ENGINE_PORT=9090
API_PORT=8080

# Optional overrides (MARKET_SYMBOLS contains comma-separated base assets).
# WEB_PORT=3000
# MARKET_SYMBOLS=BTC,ETH,SOL,USDC
# MARKET_SYNC_SECONDS=900
# LARGE_CAP_MIN_DAILY_VOLUME=10000000
# BINANCE_REST_URL=https://data-api.binance.vision
# BINANCE_WS_URL=wss://data-stream.binance.vision
# RUST_LOG=info
# For `task web` outside Docker (Compose sets this to http://api:8080):
# METRON_API_URL=http://127.0.0.1:8080
